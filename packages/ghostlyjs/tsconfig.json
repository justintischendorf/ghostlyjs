{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node types for src/cli; the DOM lib from the base covers src/core and
    // src/react.
    "types": ["node"],
    // Every export needs explicit types. This lets tsdown generate the .d.ts
    // files with oxc instead of the TypeScript compiler.
    "isolatedDeclarations": true,
    "declaration": true
  },
  "include": ["src", "tsdown.config.ts"]
}
