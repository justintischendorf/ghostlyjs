{
  "name": "ghostlyjs",
  "version": "0.0.1",
  "description": "Auto-generate skeleton loaders for React by measuring your real UI. No more hand-written skeletons.",
  "keywords": [
    "react",
    "skeleton",
    "skeleton-loader",
    "loading-state",
    "skeleton-screen"
  ],
  "license": "MIT",
  "author": "Justin Tischendorf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justintischendorf/ghostlyjs.git",
    "directory": "packages/ghostlyjs"
  },
  "homepage": "https://github.com/justintischendorf/ghostlyjs#readme",
  "bugs": {
    "url": "https://github.com/justintischendorf/ghostlyjs/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ghostly": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
